# Frontend settings - copy this file to ".env" and adjust the values.
# Everything works with the defaults, so none of these are required.

# API base URL. LEAVE IT EMPTY -- in every environment.
#
# Locally the Vite proxy forwards /api to the Go server; in production the Go
# server IS what served this page, so a relative path already reaches it.
#
# Setting it to a separate host (VITE_API_URL=https://api.karecik.com) breaks two
# things at once: the session cookie is not sent cross-origin, so the panel 401s
# on every request, and customer menus 404 because the tenant is resolved from
# the request Host -- which would then be "api", a reserved label.
#
# It is baked into the bundle at build time, so changing it means rebuilding.
VITE_API_URL=

# Production root domain - menus are served from <slug>.karecik.com
VITE_APP_DOMAIN=karecik.com

# Local root domain used for subdomain testing.
# With the default "localhost", http://demo-kafe.localhost:5173 works.
# If you added a custom name to your hosts file, put it here (e.g. karecik.local)
VITE_ROOT_DOMAIN=localhost
