# Frontend ayarlari — bu dosyayi ".env" adiyla kopyalayip duzenle.
# Hicbirini ayarlamasan da varsayilanlarla calisir.

# API taban adresi. Bos birakilirsa Vite proxy'si kullanilir (onerilen).
# Ayri bir sunucuya baglanmak istersen: VITE_API_URL=https://api.karecik.com
VITE_API_URL=

# Canlidaki kok alan adi — menuler <slug>.karecik.com adresinden acilir
VITE_APP_DOMAIN=karecik.com

# Yerelde subdomain testi icin kok alan adi.
# Varsayilan "localhost" ile http://demo-kafe.localhost:5173 calisir.
# hosts dosyasina ozel bir ad eklediysen onu yaz (orn. karecik.local)
VITE_ROOT_DOMAIN=localhost
