# ---------------------------------------------------------------------------
# Karecik backend ayarlari
# Bu dosyayi ".env" adiyla kopyalayip degerleri kendine gore duzenle.
#   Windows : Copy-Item .env.example .env
#   macOS   : cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL baglanti adresi
#   postgres://KULLANICI:SIFRE@HOST:PORT/VERITABANI?sslmode=disable
# Sifrende @ : / ? # varsa URL-encode et (@ -> %40, # -> %23, / -> %2F)
DATABASE_URL=postgres://postgres:postgres123@localhost:5432/karecik?sslmode=disable

# JWT imzalama anahtari - PRODUCTION'DA MUTLAKA DEGISTIR (en az 32 karakter)
JWT_SECRET=degistir-bunu-cok-gizli-ve-uzun-bir-anahtar-olsun-2026

# API sunucusunun dinleyecegi port
PORT=8080

# Canlidaki kok alan adi. Menuler <slug>.karecik.com adresinden acilir.
APP_DOMAIN=karecik.com

# Yerelde subdomain testi icin kok alan adi (<slug>.localhost:5173 calisir)
DEV_DOMAIN=localhost

# CORS icin izinli kaynaklar (virgulle ayir)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Yuklenen gorsellerin kaydedilecegi klasor
UPLOAD_DIR=./uploads

# Yuklenebilecek en buyuk dosya boyutu (byte) - 5 MB
MAX_UPLOAD_BYTES=5242880

# Ilk acilista demo kafe menusunu olustur (demo@karecik.com / demo1234)
SEED_DEMO=true

# Production: derlenmis frontend'i (frontend/dist) ayni sunucudan servis et
SERVE_STATIC=false
STATIC_DIR=../frontend/dist

# development | production
APP_ENV=development
