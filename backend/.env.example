# ---------------------------------------------------------------------------
# Karecik backend settings
# Copy this file to ".env" and adjust the values.
#   Windows : Copy-Item .env.example .env
#   macOS   : cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F)
DATABASE_URL=postgres://postgres:postgres123@localhost:5432/karecik?sslmode=disable
# Interface the API binds to. 127.0.0.1 is loopback only: nothing outside this
# machine can reach it and Windows Firewall never asks for permission.
# Set 0.0.0.0 to expose the API on your LAN (e.g. to open the menu on a phone);
# the firewall prompt comes back with it.
HOST=127.0.0.1

# Port the API server listens on
PORT=8080

# Production root domain. Menus are served from <slug>.karecik.com
APP_DOMAIN=karecik.com

# Local root domain for subdomain testing (<slug>.localhost:5173 works)
DEV_DOMAIN=localhost

# Allowed CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Directory uploaded images are written to
UPLOAD_DIR=./uploads

# Largest accepted upload in bytes - 5 MB
MAX_UPLOAD_BYTES=5242880
# Production: serve the built frontend (frontend/dist) from this same server
SERVE_STATIC=false
STATIC_DIR=../frontend/dist

# development | production
APP_ENV=development

# --- Session cookie ------------------------------------------------------
# There is no JWT secret any more. A session is an entry in the API process's
# own memory, keyed by the SHA-256 of this cookie -- not a signed blob the
# browser carries, and not a database row either.
#
# Two consequences worth knowing before you chase a bug: restarting the API
# signs everyone out, and the API must run as ONE instance (a second copy does
# not share the map). docs/DEPLOY.md has the details.
#
# COOKIE_DOMAIN   empty locally. Set it to .karecik.com ONLY when the API
#                 answers on that domain too, so every subdomain shares one
#                 cookie. A Domain the response host does not belong to is
#                 dropped silently: login looks like it worked and nothing
#                 is stored.
# COOKIE_SAMESITE Lax is right when the SPA and the API share a registrable
#                 domain (karecik.com + api.karecik.com). Use None only when
#                 they are genuinely different sites (pages.dev + railway.app);
#                 then COOKIE_SECURE must be true or the browser drops it.
# COOKIE_SECURE   defaults to true when APP_ENV=production.
COOKIE_DOMAIN=
COOKIE_SAMESITE=Lax
COOKIE_SECURE=false
