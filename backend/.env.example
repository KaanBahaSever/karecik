# ---------------------------------------------------------------------------
# Karecik backend settings
# Copy this file to ".env" and adjust the values.
#   Windows : Copy-Item .env.example .env
#   macOS   : cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F)
DATABASE_URL=postgres://postgres:postgres123@localhost:5432/karecik?sslmode=disable
# Interface the API binds to. 127.0.0.1 is loopback only: nothing outside this
# machine can reach it and Windows Firewall never asks for permission.
# Set 0.0.0.0 to expose the API on your LAN (e.g. to open the menu on a phone);
# the firewall prompt comes back with it.
HOST=127.0.0.1

# Port the API server listens on
PORT=8080

# Production root domain. Menus are served from <slug>.karecik.com
APP_DOMAIN=karecik.com

# Local root domain for subdomain testing (<slug>.localhost:5173 works)
DEV_DOMAIN=localhost

# Allowed CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Directory uploaded images are written to
UPLOAD_DIR=./uploads

# Largest accepted upload in bytes - 5 MB
MAX_UPLOAD_BYTES=5242880
# Serve the built frontend from this same server.
#
# Both values below are the LOCAL defaults: off, because Vite serves the SPA on
# :5173 during development, and a path relative to backend/ where you run the
# binary from. The container sets its own (SERVE_STATIC=true and an ABSOLUTE
# STATIC_DIR) -- do not copy these two into a deployment, "../frontend/dist"
# resolves outside the app directory there.
SERVE_STATIC=false
STATIC_DIR=../frontend/dist

# development | production
APP_ENV=development

# --- Session cookie ------------------------------------------------------
# There is no JWT secret any more. A session is an entry in the API process's
# own memory, keyed by the SHA-256 of this cookie -- not a signed blob the
# browser carries, and not a database row either.
#
# Two consequences worth knowing before you chase a bug: restarting the API
# signs everyone out, and the API must run as ONE instance (a second copy does
# not share the map). docs/DEPLOY.md has the details.
#
# One container serves both halves, so the page and the API always share an
# origin and the defaults below are the whole story.
#
# COOKIE_DOMAIN   EMPTY, which makes the cookie host-only. The panel is on
#                 karecik.com; setting .karecik.com would also send the session
#                 to every tenant's {slug}.karecik.com, which nothing there
#                 needs -- customer menus are entirely unauthenticated. A Domain
#                 the response host does not belong to is dropped silently:
#                 login looks like it worked and nothing is stored.
# COOKIE_SAMESITE Lax. None is only for genuinely cross-site setups and needs
#                 COOKIE_SECURE=true, or the browser drops the cookie without
#                 saying so.
# COOKIE_SECURE   defaults to true when APP_ENV=production.
COOKIE_DOMAIN=
COOKIE_SAMESITE=Lax
COOKIE_SECURE=false

# --- Transactional e-mail (password reset) --------------------------------
# Only the "şifremi unuttum" flow uses these. Leave them blank and that flow is
# DISABLED: the endpoint answers 503 instead of accepting the request and
# dropping the mail, and cmd/resetpw stays the way to set a password.
#
# Delivery goes over the provider's HTTPS API rather than SMTP, because the
# hosting platform blocks outbound SMTP on its free and hobby plans -- port 587
# simply never connects there, while an HTTPS call is unaffected.
#
# RESEND_API_KEY  from resend.com -> API Keys. Starts with "re_".
# MAIL_FROM       the sender, on a domain VERIFIED with the provider. An
#                 unverified sender is accepted at boot and rejected at send
#                 time, which shows up as mail that never arrives -- check the
#                 server log, it carries the provider's own complaint.
RESEND_API_KEY=
MAIL_FROM=

# The origin the reset LINK is built from -- the address a browser can actually
# open, which HOST and PORT do not describe (those are the interface this
# process binds to, behind whatever terminates TLS).
# Defaults to http://localhost:5173 in development and https://$APP_DOMAIN in
# production, so it usually needs no value at all.
PUBLIC_URL=

# --- Client address resolution (audit logging + rate limiting) -------------
# Every request logs one line carrying ip, port and src. src says HOW the
# address was established, because that is what decides whether the line is
# evidence or a guess:
#
#   cloudflare              proven via EDGE_SECRET. The only source that also
#                           records a port.
#   cloudflare-unverified   CF-Connecting-IP with nothing proving the request
#                           came through Cloudflare. Almost always genuine, but
#                           forgeable by anyone reaching the origin directly.
#   edge                    X-Real-IP, written by Railway's edge. Behind an
#                           orange-cloud hostname this is Cloudflare, not the
#                           visitor.
#   peer / unknown          the TCP peer, or nothing. Behind Railway the peer is
#                           an internal address shared by every visitor.
#
# EDGE_SECRET turns "unverified" into proof AND is what makes the source port
# appear at all. Generate a long random value, then add a Cloudflare Transform
# Rule (HTTP Request Header Modification) on the zone that sets:
#
#   X-Edge-Secret   static      <the same value>
#   X-Client-Port   expression  cf.edge.client_port
#
# Without the rule there is no port anywhere: neither Railway's edge nor
# Cloudflare forwards the client's source port by default.
EDGE_SECRET=
EDGE_SECRET_HEADER=X-Edge-Secret
CLIENT_PORT_HEADER=X-Client-Port

# Allow X-Forwarded-For as a last-resort address source. OFF by default:
# Railway does not document setting or sanitising that header, so a value in it
# may be verbatim client input. It is never used as a rate-limit key either way.
TRUST_FORWARDED_FOR=false
