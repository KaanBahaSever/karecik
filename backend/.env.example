# ---------------------------------------------------------------------------
# Karecik backend settings
# Copy this file to ".env" and adjust the values.
#   Windows : Copy-Item .env.example .env
#   macOS   : cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL connection string
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=disable
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F)
DATABASE_URL=postgres://postgres:postgres123@localhost:5432/karecik?sslmode=disable

# JWT signing key - MUST be changed in production (at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret-2026

# Port the API server listens on
PORT=8080

# Production root domain. Menus are served from <slug>.karecik.com
APP_DOMAIN=karecik.com

# Local root domain for subdomain testing (<slug>.localhost:5173 works)
DEV_DOMAIN=localhost

# Allowed CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Directory uploaded images are written to
UPLOAD_DIR=./uploads

# Largest accepted upload in bytes - 5 MB
MAX_UPLOAD_BYTES=5242880

# Create the demo cafe menu on first start (demo@karecik.com / demo1234)
SEED_DEMO=true

# Production: serve the built frontend (frontend/dist) from this same server
SERVE_STATIC=false
STATIC_DIR=../frontend/dist

# development | production
APP_ENV=development
